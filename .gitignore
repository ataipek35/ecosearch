# VS Code (keep shared settings, ignore the rest)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# Flutter/Dart/Pub related
# pubspec.lock is committed for apps so everyone builds with the same versions
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android related
**/android/**/gradle-wrapper.jar
.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# iOS / macOS related (iOS release is out of scope, but generated files stay out of git)
