# Secrets: AI/API keys stay on the backend and never go into git
.env
.env.*
!.env.example
*.pem
**/serviceAccountKey*.json
**/*-firebase-adminsdk-*.json

# Backend (FastAPI and/or Firebase Cloud Functions)
